# Copy to .env.docker (git-ignored). Used by compose.yaml.
# DATABASE_URL / MIGRATE_DATABASE_URL are set by compose for the local `db` container.
# To point the containers at another Postgres (e.g. staging RDS via SSM port forwarding), set them here.

BETTER_AUTH_SECRET=change-me-to-32+-random-bytes
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

SEED_SUPERADMIN_EMAIL=admin@questronix.com.ph
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_PASSWORD=change-me-strong-password
SEED_DEMO=1

# Email: leave the Azure vars empty to use the console mail driver (emails are logged, not sent)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
MAIL_SENDER=
MAIL_REPLY_TO=
MAIL_OVERRIDE_TO=

STORAGE_DRIVER=local
