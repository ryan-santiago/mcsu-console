# Copy to .env.local for `pnpm dev` on the host. Every variable is declared in src/lib/env.ts.
# Full list and phases: docs/02-tech-stack-and-setup.md#environment-variables

APP_ENV=local
APP_URL=http://localhost:3000

# Postgres from `docker compose up -d db`
DATABASE_URL=postgresql://mcsu:mcsu@localhost:5432/mcsu_console
MIGRATE_DATABASE_URL=postgresql://mcsu:mcsu@localhost:5432/mcsu_console

# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me-to-32+-random-bytes-xxxxxxxx
BETTER_AUTH_URL=http://localhost:3000

# Seed (first Super Admin, milestone 1.3) and demo data
SEED_SUPERADMIN_EMAIL=mcsu_automations@questronix.com.ph
SEED_SUPERADMIN_NAME=MCSU Automations
SEED_SUPERADMIN_PASSWORD=change-me-strong-password
SEED_DEMO=1
